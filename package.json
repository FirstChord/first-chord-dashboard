{
  "name": "music-school-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-configs.js --no-backup",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-configs.js --no-backup",
    "build": "next build",
    "start": "next start",
    "state": "node scripts/state.mjs",
    "pretest:admin": "node scripts/generate-configs.js --no-backup",
    "test:admin": "node --test tests/admin/*.test.mjs",
    "sync-admin-tutors": "node scripts/sync-admin-tutors.js",
    "check-admin-tutors": "node scripts/sync-admin-tutors.js --check",
    "backup:sheets": "node scripts/backup-sheets-tabs.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "retention:report": "node scripts/retention-report.mjs",
    "lifecycle:refresh": "node scripts/refresh-student-lifecycle.mjs",
    "ensure:state-tabs": "node scripts/ensure-state-tabs.mjs",
    "ensure:practice-delivery-claims": "node scripts/ensure-practice-delivery-claims.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "generate-code-map": "node scripts/code-map.mjs generate",
    "code-map:check": "node scripts/code-map.mjs check",
    "code-map:find": "node scripts/code-map.mjs find",
    "code-map:impact": "node scripts/code-map.mjs impact",
    "hygiene:check": "node scripts/hygiene-check.mjs",
    "eval:incoming": "node scripts/eval-incoming-classifier.mjs",
    "eval:practice-chat": "node scripts/eval-practice-chat.mjs",
    "eval:practice-summaries": "node scripts/eval-practice-summaries.mjs",
    "install:backup-schedule": "node scripts/install-sheets-backup-launch-agent.mjs",
    "lint": "eslint app components lib middleware.js --max-warnings=0",
    "analyze": "ANALYZE=true npm run build",
    "prevalidate": "node scripts/generate-configs.js --no-backup",
    "validate": "node scripts/validate-students.js",
    "generate-configs": "node scripts/generate-configs.js",
    "preview:email": "node scripts/preview-email.mjs"
  },
  "dependencies": {
    "googleapis": "^176.0.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.22",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
